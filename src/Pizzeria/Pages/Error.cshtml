@page
@model ErrorModel
@inject IOptions<BusinessInfo> BusinessOptions
@{
    ViewData["Title"] = "Error";
}

<section class="section section--cream" aria-labelledby="error-title">
    <div class="container">
        <h1 class="section__title" id="error-title">Algo falló al cargar la página</h1>
        <p class="prose">Vuelve al inicio e inténtalo de nuevo. Si quieres pedir ahora, escríbenos por WhatsApp.</p>
        <div class="actions">
            <a class="btn btn--primary" asp-page="/Index">Volver al inicio</a>
            <a class="btn btn--plain" href="@BusinessOptions.Value.WhatsAppUrl">Pedir por WhatsApp</a>
        </div>
    </div>
</section>
